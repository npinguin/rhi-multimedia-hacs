{
  "schema_version": 1,
  "principle": "one source concern, one owner",
  "owners": {
    "shared_core": {
      "path": "src/vendor",
      "owns": [
        "Pinned RHI UX Core visual grammar and provenance only"
      ]
    },
    "runtime": {
      "path": "src/runtime",
      "owns": [
        "Reading existing native room status properties only; no aggregate fallback",
        "Backend-owned intent eligibility",
        "Home Assistant service dispatch boundary",
        "Exact optional Core contextual scope and Planning summary query"
      ]
    },
    "domain": {
      "path": "src/domain",
      "owns": [
        "Native room status-to-view mapping and counts of visible rows",
        "User-facing status labels",
        "Presentation metadata only"
      ]
    },
    "ui": {
      "path": "src/ui",
      "owns": [
        "Navigation",
        "Overview",
        "Rooms",
        "Activities",
        "Devices",
        "Diagnostics",
        "Transient interaction state",
        "Presentation events",
        "Scoped optional shared Core card composition; no Core data/editor duplication"
      ]
    },
    "assets": {
      "path": "src/assets",
      "owns": [
        "Multimedia domain visual masters",
        "RHI UX Core company SVG unchanged"
      ]
    },
    "package": {
      "path": "tools/build.mjs",
      "owns": [
        "Deterministic bundle and complete dist",
        "Build-time Core injection",
        "Version authority from integration manifest"
      ]
    }
  }
}
